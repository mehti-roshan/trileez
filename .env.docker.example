# Copy to .env and replace all placeholder credentials and example domains before deployment.
WEB_PORT=80
APP_VERSION=0.1.0
LOG_LEVEL=info
CLIENT_ORIGIN=https://panel.example.com
JWT_SECRET=replace-with-a-long-random-secret
PROJECT_ACCESS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
MONGO_ROOT_USERNAME=replace-with-mongodb-admin-user
MONGO_ROOT_PASSWORD=replace-with-a-long-random-mongodb-password
# URL-encode special characters in the username/password used in this URI.
MONGO_URI=mongodb://replace-with-mongodb-admin-user:replace-with-url-encoded-password@mongodb:27017/trileez?authSource=admin
MONGO_MAX_POOL_SIZE=20
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=60
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=trileez-files
# Leave max volumes at 0 for automatic capacity sizing; lower the volume size on small development disks if needed.
SEAWEEDFS_VOLUME_SIZE_MB=1024
SEAWEEDFS_MAX_VOLUMES=0
MAX_UPLOAD_BYTES=10485760
ORGANIZATION_STORAGE_QUOTA_BYTES=1073741824
UPLOAD_ORPHAN_GRACE_MINUTES=60
AUTO_SEED=false
# Used only by the explicit one-shot seed service. Use a strong internal-test password.
SEED_ADMIN_EMAIL=admin@trileez.ir
SEED_ADMIN_PASSWORD=replace-with-a-strong-seed-admin-password
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_CONCURRENCY=2
JOB_LEASE_SECONDS=120
JOB_RETENTION_DAYS=30
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_FROM=noreply@example.com
TRUST_PROXY_HOPS=1
SHUTDOWN_TIMEOUT_MS=25000
DEPENDENCY_TIMEOUT_MS=5000
STARTUP_MAX_ATTEMPTS=10
STARTUP_RETRY_BASE_MS=500
METRICS_ENABLED=true
