PORT=4000
SERVICE_NAME=trivix-panel-api
APP_VERSION=0.1.0
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=25000
DEPENDENCY_TIMEOUT_MS=5000
STARTUP_MAX_ATTEMPTS=10
STARTUP_RETRY_BASE_MS=500
METRICS_ENABLED=true
JWT_SECRET=replace-this-in-production
PROJECT_ACCESS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=60
MONGO_URI=
MONGO_MAX_POOL_SIZE=20
USE_MOCK_DB=true
CLIENT_ORIGIN=http://localhost:5173
STORAGE_DRIVER=memory
S3_ENDPOINT=localhost
S3_PORT=8333
S3_USE_SSL=false
S3_ACCESS_KEY=trivix-storage
S3_SECRET_KEY=change-this-storage-secret
S3_BUCKET=trivix-files
MAX_UPLOAD_BYTES=10485760
ORGANIZATION_STORAGE_QUOTA_BYTES=1073741824
UPLOAD_ORPHAN_GRACE_MINUTES=60
AUTO_SEED=false
SEED_ADMIN_EMAIL=admin@trileez.ir
SEED_ADMIN_PASSWORD=change-this-demo-password
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_CONCURRENCY=2
JOB_LEASE_SECONDS=120
JOB_RETENTION_DAYS=30
# Optional HTTP email provider endpoint. Requests include an Idempotency-Key header.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_FROM=noreply@trivix.local
