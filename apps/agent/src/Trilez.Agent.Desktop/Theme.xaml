<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="App.Background" Color="#F4F6F8" />
  <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="App.Accent" Color="#0F6E6B" />
  <SolidColorBrush x:Key="App.AccentDark" Color="#0B5552" />
  <SolidColorBrush x:Key="App.Nav" Color="#0F6E6B" />
  <SolidColorBrush x:Key="App.Text" Color="#1C2430" />
  <SolidColorBrush x:Key="App.Muted" Color="#5C6B7A" />
  <SolidColorBrush x:Key="App.Line" Color="#E2E8EE" />
  <SolidColorBrush x:Key="App.Danger" Color="#9B2C2C" />
  <SolidColorBrush x:Key="App.DangerSurface" Color="#FDECEC" />
  <SolidColorBrush x:Key="App.Success" Color="#0E6B3C" />
  <SolidColorBrush x:Key="App.SuccessSurface" Color="#E7F6EE" />
  <SolidColorBrush x:Key="App.Warning" Color="#8A5A00" />
  <SolidColorBrush x:Key="App.WarningSurface" Color="#FFF6E8" />
  <SolidColorBrush x:Key="App.Chip" Color="#E6F3F2" />

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{StaticResource App.Background}" />
    <Setter Property="Foreground" Value="{StaticResource App.Text}" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource App.Muted}" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource App.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource App.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="{StaticResource App.Line}" />
    <Setter Property="Background" Value="{StaticResource App.Surface}" />
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Input}" />

  <Style x:Key="SecretInput" TargetType="PasswordBox">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="{StaticResource App.Line}" />
    <Setter Property="Background" Value="{StaticResource App.Surface}" />
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource App.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource App.AccentDark}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource App.AccentDark}" />
    <Setter Property="Background" Value="{StaticResource App.Surface}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource App.Line}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
